# Copy to .env (git-ignored) or export these in your shell / hosting provider.
# Required in production. In development a random secret is generated in data/.jwt-secret.
JWT_SECRET=
PORT=3000
# Comma-separated list of allowed browser origins. Defaults to * (tokens are sent as headers, not cookies).
CORS_ORIGIN=
# Where the SQLite database and uploaded files are stored.
DATA_DIR=./data
MAX_UPLOAD_MB=10
TOKEN_TTL=7d
